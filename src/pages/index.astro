---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import BootSequence from '../components/BootSequence.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import Shell from '../components/Shell.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const recentPosts = allPosts.slice(0, 3);
const shellPosts = allPosts.map((post) => ({
	id: post.id,
	title: post.data.title,
	description: post.data.description,
	date: post.data.pubDate.toISOString().slice(0, 10),
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<BootSequence />
		<Header />
		<main>
			<TerminalWindow title="yasin@lowlevel:~">
				<p class="line"><span class="prompt">$</span> whoami</p>
				<p class="output">yasin — systems tinkerer</p>
				<p class="line"><span class="prompt">$</span> cat interests.txt</p>
				<p class="output">hardware · assembly · linux internals · reverse engineering</p>
				<p class="line"><span class="prompt">$</span> ls -la ./</p>
				<p class="output">writing up what I learn while poking at low-level systems.</p>
				<Shell posts={shellPosts} />
			</TerminalWindow>

			<section class="recent">
				<h2>recent posts</h2>
				<div class="post-grid">
					{
						recentPosts.map((post) => (
							<PostCard
								href={`/blog/${post.id}/`}
								title={post.data.title}
								pubDate={post.data.pubDate}
								tags={post.data.tags}
							/>
						))
					}
				</div>
				<a class="more" href="/blog">→ all posts</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.line {
		margin: 0 0 0.2em 0;
	}
	.prompt {
		color: var(--color-accent);
		margin-right: 0.5em;
	}
	.output {
		margin: 0 0 1em 0;
		color: var(--color-text);
	}
	.output:last-child {
		margin-bottom: 0;
	}
	.recent {
		margin-top: 3em;
	}
	.recent h2 {
		font-size: 1.1em;
		color: var(--color-muted);
		text-transform: lowercase;
		letter-spacing: 0.02em;
	}
	.post-grid {
		display: grid;
		gap: 1em;
		margin-top: 1em;
	}
	.more {
		display: inline-block;
		margin-top: 1.5em;
		color: var(--color-accent);
		text-decoration: none;
		font-size: 0.9em;
	}
	.more:hover {
		text-decoration: underline;
	}
</style>
