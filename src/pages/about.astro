---
import Tag from '../components/Tag.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import Layout from '../layouts/BlogPost.astro';

const stack = ['typescript', 'react', 'java', 'spring-boot', 'kubernetes', 'jenkins'];
const interests = ['os-internals', 'security', 'assembly', 'hardware'];
---

<Layout
	title="About"
	description="Fullstack developer at CHECK24, finishing a CS degree, endlessly curious about how computers actually work."
	pubDate={new Date('Aug 22 2026')}
>
	<TerminalWindow title="yasin@lowlevel:~/about">
		<p class="line"><span class="prompt">$</span> whoami</p>
		<p class="output">
			Fullstack developer at CHECK24, currently finishing my Computer Science bachelor's.
		</p>
	</TerminalWindow>

	<h2>work</h2>
	<p>
		I work at CHECK24 on the car insurance (KFZ) product. I am responsible for the application
		process from start to finish: the frontend in TypeScript and React, the backend in Java and
		Spring Boot, the Jenkins pipelines for deployment and the Kubernetes setup it runs on.
	</p>
	<div class="tags">
		{stack.map((tag) => <Tag label={tag} />)}
	</div>

	<h2>off the clock</h2>
	<p>
		In my free time I want to know how computers work under the hood: how a CPU executes an
		instruction, how an operating system schedules processes and how a system can be attacked.
		At work I mostly build web applications, so this blog is where I write down what I learn
		about low-level topics and security.
	</p>
	<div class="tags">
		{interests.map((tag) => <Tag label={tag} />)}
	</div>

	<h2>elsewhere</h2>
	<p>
		Away from the computer I do breakdance and go to the gym.
	</p>
</Layout>

<style>
	.line {
		margin: 0 0 0.2em 0;
	}
	.prompt {
		color: var(--color-accent);
		margin-right: 0.5em;
	}
	.output {
		margin: 0;
		color: var(--color-text);
	}
	h2 {
		margin-top: 2em;
		font-size: 1.1em;
		color: var(--color-muted);
		text-transform: lowercase;
		letter-spacing: 0.02em;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		margin: -0.5em 0 1.5em 0;
	}
</style>
